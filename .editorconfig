# https://editorconfig.org — matches the existing codebase style (4-space
# indent, LF, UTF-8). Kept minimal so it doesn't fight the current source.
root = true

[*]
indent_style = space
indent_size = 4
end_of_line = lf
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

[*.{yml,yaml}]
indent_size = 2
