# --- Bancho (osu! IRC) ---------------------------------------------------
# The osu! account the bot logs in as. IRC username = your osu! username.
# IRC password is NOT your website password — get it at
#   https://osu.ppy.sh/home/account/edit   → "Legacy API"  → IRC password
# (or https://osu.ppy.sh/p/irc). It's a short random string.
BANCHO_USERNAME=your_osu_name
BANCHO_PASSWORD=your_irc_password

# Set to 1 ONLY after ppy has flagged this account as a "bot" account
# (ask in #osu-help / a dev). It raises the message-rate limit a lot.
# Leave unset/0 for a normal account — the bot paces itself accordingly.
BANCHO_BOT_ACCOUNT=0

# --- Netlify Blobs (the request queue shared with the website) ----------
# Same two values the website's functions use.
#   NETLIFY_BLOBS_SITE_ID  = Netlify → Project configuration → Project ID
#   NETLIFY_BLOBS_TOKEN    = Netlify → User settings → Applications → new token
NETLIFY_BLOBS_SITE_ID=
NETLIFY_BLOBS_TOKEN=

# --- Optional ----------------------------------------------------------
# osu! API v1 key (https://osu.ppy.sh/p/api) — only used to enrich the
# in-lobby "!info" line with live star rating. The website already sends
# a title + stars per map, so this is optional.
OSU_API_KEY=

# Poll the queue this often (ms).
POLL_MS=5000
# Close a lobby after it has been empty this long (ms).
LOBBY_IDLE_CLOSE_MS=300000
# Force-advance to the next map if a match hasn't finished in this long (ms).
MAP_TIMEOUT_MS=420000
